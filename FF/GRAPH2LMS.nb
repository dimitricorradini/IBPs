    RowBox[{"Nodes_", ",", "Edges_", ",", "Masses_"}], "]"}], ":=", 
   RowBox[{"HighlightGraph", "[", 
    RowBox[{
     RowBox[{"EdgeTaggedGraph", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Edges", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "\[UndirectedEdge]", 
            RowBox[{"Edges", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "Edges", "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["p", "i"], "\[UndirectedEdge]", 
            RowBox[{
            "Nodes", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}],
            ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "Nodes", "]"}]}], "}"}]}], "]"}]}], "]"}],
        ",", 
       RowBox[{"VertexLabels", "\[Rule]", "\"\<Name\>\""}]}], "]"}], ",", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{
             RowBox[{
             "Masses", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
              "===", "0"}]}], ",", 
           TemplateBox[{
             RowBox[{"Edges", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], 
             RowBox[{"Edges", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], "1"},
            "UndirectedEdge"]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "Masses", "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{
             RowBox[{
             "Masses", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
              "===", "0"}]}], ",", 
           TemplateBox[{
             RowBox[{"Edges", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], 
             RowBox[{"Edges", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], "2"},
            "UndirectedEdge"]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "Masses", "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
            "Masses", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            "===", "0"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{
             TemplateBox[{
               RowBox[{"Edges", "\[LeftDoubleBracket]", 
                 RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], 
               RowBox[{"Edges", "\[LeftDoubleBracket]", 
                 RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], "1"},
              "UndirectedEdge"], ",", "Blue", ",", "Dashed"}], "]"}]}], "]"}],
          ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "Masses", "]"}]}], "}"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
