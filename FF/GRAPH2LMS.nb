Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"ExtractGraphInfo", "[", "g_Graph", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vertices", ",", "edges", ",", "degreeOne", ",", "externalNodes"}], 
     "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{"Get", " ", "vertices"}], "*)"}], 
    RowBox[{
     RowBox[{"vertices", "=", 
      RowBox[{"VertexList", "[", "g", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Get", " ", "edges", " ", "as", " ", "list", " ", "of", " ", 
       "couples"}], "*)"}], 
     RowBox[{"edges", "=", 
      RowBox[{
       RowBox[{"EdgeList", "[", "g", "]"}], "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"UndirectedEdge", "[", 
           RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}]}], ",", 
         RowBox[{
          RowBox[{"DirectedEdge", "[", 
           RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}]}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Find", " ", "vertices", " ", "with", " ", "degree", " ", "1", " ", 
       RowBox[{"(", 
        RowBox[{"external", " ", "legs"}], ")"}]}], "*)"}], 
     RowBox[{"degreeOne", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"vertices", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"VertexDegree", "[", 
           RowBox[{"g", ",", "#"}], "]"}], "==", "1"}], "&"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Find", " ", "vertices", " ", "connected", " ", "to", " ", "degree"}], 
       "-", 
       RowBox[{"1", " ", "vertices", " ", 
        RowBox[{"(", 
         RowBox[{
         "nodes", " ", "where", " ", "external", " ", "momenta", " ", 
          "enter"}], ")"}]}]}], "*)"}], 
     RowBox[{"externalNodes", "=", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Cases", "[", 
          RowBox[{"edges", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a_", ",", "b_"}], "}"}], "/;", 
             RowBox[{"MemberQ", "[", 
              RowBox[{"degreeOne", ",", "a"}], "]"}]}], ":>", "b"}]}], "]"}], 
         "]"}], "~", "Join", "~", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Cases", "[", 
          RowBox[{"edges", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a_", ",", "b_"}], "}"}], "/;", 
             RowBox[{"MemberQ", "[", 
              RowBox[{"degreeOne", ",", "b"}], "]"}]}], ":>", "a"}]}], "]"}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Return", " ", "as", " ", "association"}], "*)"}], 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Vertices\>\"", "->", "vertices"}], ",", 
       RowBox[{"\"\<Edges\>\"", "->", "edges"}], ",", 
       RowBox[{"\"\<Nodes\>\"", "->", "externalNodes"}]}], "|>"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SortMixed", "[", "o_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"AtomQ", "[", "o", "]"}]}], ",", 
    RowBox[{"Sort", "[", "o", "]"}], ",", "o"}], "]"}]}]}], "Input",
