Cell[BoxData[
 RowBox[{"alpha", "=", 
  RowBox[{"{", 
   RowBox[{"s", ",", "t", ",", 
    RowBox[{"s", "+", "t"}]}], "}"}]}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"a8282ca6-04ee-4c28-9d84-5e81ce8f2124"],

