Cell[BoxData["\<\"Found 720(304) zero(nonzero) sectors out of 1024.\\n    \
ZeroSectors[box3] \[LongDash] zero sectors,\\n    NonZeroSectors[box3] \
\[LongDash] nonzero sectors,\\n    SimpleSectors[box3] \[LongDash] simple \
sectors (no nonzero subsectors),\\n    BasisSectors[box3] \[LongDash] basis \
sectors (at least one immediate subsector is zero),\\n    ZerojRule[box3] \
\[LongDash] a rule to nullify all zero j[box3\[Ellipsis]],\\n    CutDs[box3] \
\[LongDash] a flag list of cut denominators (1=cut).\"\>"], "Print",
 CellChangeTimes->{3.9791472922411118`*^9, 3.979203915727179*^9, 
