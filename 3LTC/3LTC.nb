}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"cs", "=", 
   RowBox[{"c", "/@", 
    RowBox[{"Range", "[", 
     RowBox[{"Length", "[", "alpha", "]"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.9725585471115513`*^9},
 CellLabel->"In[22]:=",ExpressionUUID->"14f31111-7591-4aa8-830d-bd87b847d05d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqss", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"eqs", "[", 
        RowBox[{"ii", ",", "jj"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"jj", ",", "1", ",", 
         RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", 
       RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqts", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"eqt", "[", 
        RowBox[{"ii", ",", "jj"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"jj", ",", "1", ",", 
         RowBox[{"Length", "[", "dt", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", 
       RowBox[{"Length", "[", "dt", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9725585546500053`*^9, 3.972558559079735*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"6dceeba9-408b-45c3-b496-c0054de42ffb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"eqs", "[", 
      RowBox[{"ii", ",", "jj"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"ds", "[", 
        RowBox[{"[", "ii", "]"}], "]"}], "[", 
       RowBox[{"[", "jj", "]"}], "]"}], "==", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"cs", ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Log", "[", "#", "]"}], "&"}], "/@", "alpha"}], ")"}]}], ",",
         "s"}], "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"ii", ",", "1", ",", 
      RowBox[{"Length", "[", "ds", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"jj", ",", "1", ",", 
      RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"eqt", "[", 
      RowBox[{"ii", ",", "jj"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"dt", "[", 
        RowBox[{"[", "ii", "]"}], "]"}], "[", 
       RowBox[{"[", "jj", "]"}], "]"}], "==", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"cs", ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Log", "[", "#", "]"}], "&"}], "/@", "alpha"}], ")"}]}], ",",
         "t"}], "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"ii", ",", "1", ",", 
      RowBox[{"Length", "[", "dt", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"jj", ",", "1", ",", 
      RowBox[{"Length", "[", "dt", "]"}]}], "}"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.972558561055324*^9, 3.972558570295442*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"c7a8b1cc-ba8d-46c8-8809-1ce358d8e62e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"num50", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"s", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"WorkingPrecision", "->", "50"}], "]"}]}], ",", 
       RowBox[{"t", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"WorkingPrecision", "->", "50"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "50"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"9aab1c9b-49ce-4824-abe1-99e5aa1a9c3a"],

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Asol", "[", 
        RowBox[{"ii", ",", "jj"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"eqs", "[", 
                  RowBox[{"ii", ",", "jj"}], "]"}], ",", 
                 RowBox[{"eqt", "[", 
                  RowBox[{"ii", ",", "jj"}], "]"}]}], "}"}], "/.", 
               RowBox[{"num50", "[", 
                RowBox[{"[", "iter", "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"iter", ",", "1", ",", "20"}], "}"}]}], "]"}], "]"}], ",",
            "cs"}], "]"}], "//", "Chop"}], "//", "Rationalize"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"ii", ",", "50"}], "]"}], "\[Equal]", "0"}], "&&", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"jj", ",", "50"}], "]"}], "\[Equal]", "0"}]}], ",", 
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"\"\<Done :: {\>\"", ",", "ii", ",", "\"\<,\>\"", ",", "jj", 
          ",", "\"\<}\>\""}], "]"}]}], "]"}], ";"}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", 
       RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"jj", ",", "1", ",", 
     RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9725585810856867`*^9, 3.9725585831327877`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"ac92e56f-e937-4a99-9343-8ecefc916ccd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Atilde", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"cs", ".", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Log", "[", "#", "]"}], "&"}], "/@", "alpha"}], ")"}]}],
           ")"}], "/.", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Asol", "[", 
           RowBox[{"ii", ",", "jj"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"jj", ",", "1", ",", 
          RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"ii", ",", "1", ",", 
        RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{"_c", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Atildex", "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Atilde", "/.", 
          RowBox[{"t", "\[Rule]", 
           RowBox[{"x", " ", "s"}]}]}], "/.", 
         RowBox[{"s", "\[Rule]", 
          RowBox[{"-", "1"}]}]}], "/.", 
        RowBox[{
         RowBox[{"Log", "[", "a___", "]"}], ":>", 
         RowBox[{"PowerExpand", "[", 
          RowBox[{"Log", "[", 
           RowBox[{"Factor", "[", "a", "]"}], "]"}], "]"}]}]}], "/.", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"-", "1"}], "-", "x"}], "]"}], "\[RuleDelayed]", 
        RowBox[{"Log", "[", 
         RowBox[{"1", "+", "x"}], "]"}]}]}], "/.", 
      RowBox[{"Pi", "\[Rule]", "0"}]}], ",", 
     RowBox[{"Log", "[", "___", "]"}], ",", "Together"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.972558587189166*^9, 3.972558588756852*^9}, 
   3.979306906400188*^9, {3.9793072067424603`*^9, 3.9793072107360907`*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"d60055ff-b9d8-4bb9-b6e1-f32d4c1b1e6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Export", "[", 
  RowBox[{"\"\<FF/3LTC/Atilde.m\>\"", ",", "Atildex"}], "]"}]], "Input",
