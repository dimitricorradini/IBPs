Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Asol", "[", 
        RowBox[{"ii", ",", "jj"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"eqs", "[", 
                  RowBox[{"ii", ",", "jj"}], "]"}], ",", 
                 RowBox[{"eqt", "[", 
                  RowBox[{"ii", ",", "jj"}], "]"}]}], "}"}], "/.", 
               RowBox[{"num50", "[", 
                RowBox[{"[", "iter", "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"iter", ",", "1", ",", "20"}], "}"}]}], "]"}], "]"}], ",",
            "cs"}], "]"}], "//", "Chop"}], "//", "Rationalize"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"ii", ",", "50"}], "]"}], "\[Equal]", "0"}], "&&", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"jj", ",", "50"}], "]"}], "\[Equal]", "0"}]}], ",", 
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"\"\<Done :: {\>\"", ",", "ii", ",", "\"\<,\>\"", ",", "jj", 
          ",", "\"\<}\>\""}], "]"}]}], "]"}], ";"}], ",", 
