Cell[BoxData[{
 RowBox[{
  RowBox[{"Atilde", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"cs", ".", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Log", "[", "#", "]"}], "&"}], "/@", "alphaco"}], 
            ")"}]}], ")"}], "/.", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Asol", "[", 
           RowBox[{"ii", ",", "jj"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"jj", ",", "1", ",", 
          RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"ii", ",", "1", ",", 
        RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{"_c", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Atildex", "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Atilde", "/.", 
          RowBox[{"t", "\[Rule]", 
           RowBox[{"x", " ", "s"}]}]}], "/.", 
         RowBox[{"s", "\[Rule]", 
          RowBox[{"-", "1"}]}]}], "/.", 
        RowBox[{
         RowBox[{"Log", "[", "a___", "]"}], ":>", 
         RowBox[{"PowerExpand", "[", 
          RowBox[{"Log", "[", 
           RowBox[{"Factor", "[", "a", "]"}], "]"}], "]"}]}]}], "/.", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"-", "1"}], "-", "x"}], "]"}], "\[RuleDelayed]", 
        RowBox[{"Log", "[", 
         RowBox[{"1", "+", "x"}], "]"}]}]}], "/.", 
      RowBox[{"Pi", "\[Rule]", "0"}]}], ",", 
     RowBox[{"Log", "[", "___", "]"}], ",", "Together"}], "]"}]}], 
  ";"}]}], "Input",
