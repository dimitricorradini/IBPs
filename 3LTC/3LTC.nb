Cell[BoxData[{
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"eqs", "[", 
      RowBox[{"ii", ",", "jj"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"ds", "[", 
        RowBox[{"[", "ii", "]"}], "]"}], "[", 
       RowBox[{"[", "jj", "]"}], "]"}], "==", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"cs", ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
