Cell[BoxData[{
 RowBox[{
  RowBox[{"eqss", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"eqs", "[", 
        RowBox[{"ii", ",", "jj"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"jj", ",", "1", ",", 
         RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", 
       RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqts", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"eqt", "[", 
        RowBox[{"ii", ",", "jj"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"jj", ",", "1", ",", 
         RowBox[{"Length", "[", "dt", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", 
       RowBox[{"Length", "[", "dt", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9725585546500053`*^9, 3.972558559079735*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"873ae086-3627-4fc3-8f8e-bfe37580637f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"eqs", "[", 
      RowBox[{"ii", ",", "jj"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"ds", "[", 
        RowBox[{"[", "ii", "]"}], "]"}], "[", 
       RowBox[{"[", "jj", "]"}], "]"}], "==", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"cs", ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Log", "[", "#", "]"}], "&"}], "/@", "alphaco"}], ")"}]}],
         ",", "s"}], "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"ii", ",", "1", ",", 
      RowBox[{"Length", "[", "ds", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"jj", ",", "1", ",", 
      RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"eqt", "[", 
      RowBox[{"ii", ",", "jj"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"dt", "[", 
        RowBox[{"[", "ii", "]"}], "]"}], "[", 
       RowBox[{"[", "jj", "]"}], "]"}], "==", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"cs", ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Log", "[", "#", "]"}], "&"}], "/@", "alphaco"}], ")"}]}],
         ",", "t"}], "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"ii", ",", "1", ",", 
      RowBox[{"Length", "[", "dt", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"jj", ",", "1", ",", 
      RowBox[{"Length", "[", "dt", "]"}]}], "}"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.972558561055324*^9, 3.972558570295442*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"e6cbbdfb-386e-48dc-8351-f385ea3fd571"],

Cell[BoxData[
 RowBox[{
  RowBox[{"num50", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"s", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"WorkingPrecision", "->", "50"}], "]"}]}], ",", 
       RowBox[{"t", "->", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"WorkingPrecision", "->", "50"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "50"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"82782f20-e957-40be-8094-cc6893de8d6c"],

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Asol", "[", 
        RowBox[{"ii", ",", "jj"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"eqs", "[", 
                  RowBox[{"ii", ",", "jj"}], "]"}], ",", 
                 RowBox[{"eqt", "[", 
                  RowBox[{"ii", ",", "jj"}], "]"}]}], "}"}], "/.", 
               RowBox[{"num50", "[", 
                RowBox[{"[", "iter", "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"iter", ",", "1", ",", "20"}], "}"}]}], "]"}], "]"}], ",",
            "cs"}], "]"}], "//", "Chop"}], "//", "Rationalize"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"ii", ",", "50"}], "]"}], "\[Equal]", "0"}], "&&", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"jj", ",", "50"}], "]"}], "\[Equal]", "0"}]}], ",", 
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"\"\<Done :: {\>\"", ",", "ii", ",", "\"\<,\>\"", ",", "jj", 
          ",", "\"\<}\>\""}], "]"}]}], "]"}], ";"}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", 
       RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"jj", ",", "1", ",", 
     RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9725585810856867`*^9, 3.9725585831327877`*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"ea857e5a-5136-47f8-a5de-ee78b623033b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Atilde", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"cs", ".", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Log", "[", "#", "]"}], "&"}], "/@", "alphaco"}], 
            ")"}]}], ")"}], "/.", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Asol", "[", 
           RowBox[{"ii", ",", "jj"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"jj", ",", "1", ",", 
          RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"ii", ",", "1", ",", 
        RowBox[{"Length", "[", "ds", "]"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{"_c", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Atildex", "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Atilde", "/.", 
          RowBox[{"t", "\[Rule]", 
           RowBox[{"x", " ", "s"}]}]}], "/.", 
         RowBox[{"s", "\[Rule]", 
          RowBox[{"-", "1"}]}]}], "/.", 
        RowBox[{
         RowBox[{"Log", "[", "a___", "]"}], ":>", 
         RowBox[{"PowerExpand", "[", 
          RowBox[{"Log", "[", 
           RowBox[{"Factor", "[", "a", "]"}], "]"}], "]"}]}]}], "/.", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"-", "1"}], "-", "x"}], "]"}], "\[RuleDelayed]", 
        RowBox[{"Log", "[", 
         RowBox[{"1", "+", "x"}], "]"}]}]}], "/.", 
      RowBox[{"Pi", "\[Rule]", "0"}]}], ",", 
     RowBox[{"Log", "[", "___", "]"}], ",", "Together"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.972558587189166*^9, 3.972558588756852*^9}, 
   3.979306906400188*^9, {3.9793072067424603`*^9, 3.9793072107360907`*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"85322b94-11bb-45aa-9f61-ee2879859310"],

